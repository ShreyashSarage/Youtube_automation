[
 {
  "id": "ls",
  "project": "web-bench",
  "cmd": "ls -R rust/src go node/server.js python",
  "write": [
   "post.lua",
   "bench.py",
   "node/package-lock.json",
   "node/package.json",
   "node/server.js",
   "go/go.mod",
   "go/main.go",
   "python/app_sync.py",
   "python/app.py",
   "rust/Cargo.toml",
   "rust/Cargo.lock",
   "rust/src/main.rs"
  ]
 },
 {
  "id": "specs",
  "cmd": "nproc && wrk --version | head -1"
 },
 {
  "id": "versions",
  "cmd": "rustc --version && go version && node --version && python3 -c 'import fastapi, uvicorn; print(\"FastAPI\", fastapi.__version__, \"uvicorn\", uvicorn.__version__)'"
 },
 {
  "id": "build_rust",
  "cmd": "cd rust && cargo build --release 2>&1 | tail -3",
  "shown": "cd rust && cargo build --release && cd ..",
  "timeout": 900
 },
 {
  "id": "build_go",
  "cmd": "cd go && go build -o server . && ls -lh server | awk '{print $5, $9}'",
  "shown": "cd go && go build -o server . && cd .."
 },
 {
  "id": "build_node",
  "cmd": "cd node && npm install --silent && npm ls express",
  "shown": "cd node && npm install && npm ls express && cd .."
 },
 {
  "id": "rust_start",
  "cmd": "exec taskset -c 0,1 ./rust/target/release/server",
  "shown": "taskset -c 0,1 ./rust/target/release/server &",
  "background": true,
  "wait": 3
 },
 {
  "id": "rust_curl",
  "cmd": "curl -s http://127.0.0.1:8080/api/user/42; echo"
 },
 {
  "id": "rust_warm",
  "cmd": "wrk -t2 -c50 -d5s http://127.0.0.1:8080/api/user/1 > /dev/null; echo warmed up",
  "shown": "wrk -t2 -c50 -d5s http://127.0.0.1:8080/api/user/1 > /dev/null   # warm-up"
 },
 {
  "id": "rust_get",
  "cmd": "taskset -c 2,3 wrk -t2 -c100 -d15s --latency http://127.0.0.1:8080/api/user/42"
 },
 {
  "id": "rust_c1000",
  "cmd": "taskset -c 2,3 wrk -t2 -c1000 -d15s --latency --timeout 5s http://127.0.0.1:8080/api/user/42"
 },
 {
  "kill": "rust_start"
 },
 {
  "id": "rust_cleanup",
  "cmd": "pkill -f '[s]erver.js'; pkill -f '[u]vicorn'; sleep 1; true"
 },
 {
  "id": "go_start",
  "cmd": "exec taskset -c 0,1 ./go/server",
  "shown": "taskset -c 0,1 ./go/server &",
  "background": true,
  "wait": 3
 },
 {
  "id": "go_curl",
  "cmd": "curl -s http://127.0.0.1:8080/api/user/42; echo"
 },
 {
  "id": "go_warm",
  "cmd": "wrk -t2 -c50 -d5s http://127.0.0.1:8080/api/user/1 > /dev/null; echo warmed up",
  "shown": "wrk -t2 -c50 -d5s http://127.0.0.1:8080/api/user/1 > /dev/null   # warm-up"
 },
 {
  "id": "go_get",
  "cmd": "taskset -c 2,3 wrk -t2 -c100 -d15s --latency http://127.0.0.1:8080/api/user/42"
 },
 {
